set -e

VERSION=1.0.4

export NONGIT_OK=Yes
export SUBDIRECTORY_OK=Yes
export OPTIONS_KEEPDASHDASH=
export OPTIONS_STUCKLONG=t
export OPTIONS_SPEC="\
git test [options] [refs...]

git test --clear [refs...]

git test sync

Run tests on each distinct tree

Example:
    git test --verify=\"make test\" master ^origin/master
--
 Available options are
v,verbose!      be more explicit about what is going on
q,quiet!        be quiet
r,redo=         re-test even if [any/pass/fail/both/no] result cached for tree
o,output=       output directory for reports
cache=*         specify cache directory
pre=            command to run before running tests
post=           command to run after running tests
verify=         the command to run as test
 Actions:
clear!          clear the results cache
version!        print version info and quit"

CORE=$(git --exec-path)
PATH="$CORE:$PATH"

. git-sh-setup

CR="$(printf "\r")$(tput el)"
NL='
'

rc=0
atexit_cleanup() {
    # In staged mode we tested in place without ever moving HEAD, so leave the
    # work tree (and any in-progress merge) exactly as we found it.
    if test -z "$staged_tree" ; then
        git checkout -q "$starting_point"
    fi
    unlock
    exit $rc
}

lock() {
    mkdir -p "$cache"
    msg="There's a lock dir, as if there is a git-test already in progress."
    if ! mkdir "$cache"/testing >/dev/null 2>&1; then
        echo "$msg" >&2
        echo "(lock: ${cache}/testing)" >&2
        rc=5
        exit 5
    fi
}

unlock() {
    if [ -d "$cache"/testing ]; then
        rmdir "$cache"/testing
    fi
}

progress() {
    if [ "$1" = err ]; then
        if [ -z "$GIT_QUIET" ]; then
            printf "$CR%04d | %s | %s | " \
                   "$iteration" "$short" "$small" >&2
            printf '%s' "$2" >&2
        fi
    else
        if [ -z "$GIT_QUIET" ]; then
            printf "%s" "$CR" >&2
            printf "%04d | %s | %s | " \
                   "$iteration" "$short" "$small"
            echo "$2"
        fi
    fi
}

make_output_dirs() {
    if test -n "$output"; then
        mkdir -p "$output"/commit "$output"/tree "$output"/"$now"
        if test -h "$output"/latest; then
            rm -f "$output"/latest
        fi
        ln -s "$now" "$output"/latest
    fi
}

decide_refs() {
    if test -n "$*"; then
        echo "$*"
        return
    fi

    local args=""
    local branch
    branch="$(git symbolic-ref --short -q HEAD || true)"

    if git config "branch.${branch}.test" >/dev/null 2>&1; then
        args="^$(git config "branch.${branch}.test")"
    elif git config "test.branch" >/dev/null 2>&1; then
        args="^$(git config test.branch)"
    elif git rev-parse --symbolic-full-name '@{u}' >/dev/null 2>&1; then
        upstream="$(git rev-parse --symbolic-full-name '@{u}')"
        args="^${upstream#refs/*/}"
    fi

    for remote in $(git remote); do
        remote_master="$(git branch --list --remotes "$remote/master")"
        if [ -n "$remote_master" ]; then
            args="$args ^${remote_master#  }"
        fi
        remote_branch="$(git branch --list --remotes "$remote/$branch")"
        if [ -n "$remote_branch" ]; then
            args="$args ^${remote_branch#  }"
        fi
    done

    if [ -z "$args" ]; then
        printf '%s' "Cowardly refusing to test the entire history.
(If that's what you really want, you must specify at least HEAD)" >&2
        rc=5
    else
        echo "$branch $args" | tr " " "$NL" | sort | uniq | tr "$NL" " "
    fi
}

# These cache probes report through variables (check_cache: $cached,
# recheck_cache: $overall, redo_check: $result) rather than stdout: they
# run once per commit, and forking a command substitution per call is
# what made fully-cached runs slow.
check_cache() {
    if test -f "$cache/${1}_pass"; then pass=pass; else pass=''; fi
    if test -f "$cache/${1}_fail"; then fail=fail; else fail=''; fi

    cached="$pass$fail"
}

recheck_cache() {
    check_cache "$1"
    overall="$cached"
    if [ "$overall" = "passfail" ]; then
        overall=FLAPPY
    fi
}

sync_cache() {
    common="$(git rev-parse --git-common-dir)"
    synced=0

    for other in "$common"/test-cache "$common"/worktrees/*/test-cache; do
        test -d "$other" || continue
        # skip our own cache (compare physical paths; $cache may be overridden)
        if [ "$(cd "$other" && pwd -P)" = "$(cd "$cache" && pwd -P)" ]; then
            continue
        fi
        for f in "$other"/*_pass "$other"/*_fail; do
            test -f "$f" || continue
            name="${f##*/}"
            if ! test -f "$cache/$name"; then
                touch "$cache/$name"
                synced=$((synced + 1))
            fi
        done
    done

    if test -z "$GIT_QUIET"; then
        echo "Pulled $synced results from other worktrees"
    fi
}

redo_check() {
    check_cache "$1"
    result="$cached"

    if [ -z "$result" ]; then
        return
    elif [ "$redo" = "all" ]; then
        result=''
    elif [ "$redo" = "pass" ] && [ "${result%fail}" = "pass" ]; then
        result=''
    elif [ "$redo" = "fail" ] && [ "${result#pass}" = "fail" ]; then
        result=''
    elif [ "$redo" = "both" ] && [ "${result}" = "passfail" ]; then
        result=''
    elif [ "$result" = "passfail" ]; then
        result=FLAPPY
    fi
}

link_result() {
    dest="../tree/${cache_key}_${result}"
    iter="$(printf "%s/%s/%04d_%s" "$output" "$now" "$iteration" "$result")"

    if test -f "$output/tree/${cache_key}_${result}"; then
        ln -sf "$dest" "${iter}"
        ln -sf "$dest" "${output}/commit/${short}_${result}"
    fi

}

run_test() {
    if test "$1" = staged ; then
        # The staged tree is already materialised in the work tree; there is
        # nothing to check out, so just test where we are.
        progress err "staged"
    else
        progress err "checkout"
        git checkout -q "$commit"
    fi

    if test -n "$output"; then
        out="${output}/tree/${cache_key}"
    else
        out=/dev/null
    fi

    if test -n "$pre"; then
        progress err "pre-action"
        printf '%s' "Running pre-action"        >$out
        echo "--------"                         >$out
        printf '%s' "Running: '$pre'"           >$out
        ( $pre ) >$out 2>&1 || true
    fi

    printf '%s' "Verifying"                     >$out
    echo "--------"                             >$out
    printf '%s' "Running: '$verify'"            >$out
    progress err "testing"
    if ( eval "$verify" ) >$out 2>&1; then
        result=pass
    else
        result=fail
    fi

    if test -n "$post"; then
        progress err "post-action"
        printf '%s' "Running post-action"       >$out
        echo "--------"                         >$out
        printf '%s' "Running: '$post'"          >$out
        ( $post ) >$out 2>&1 || true
    fi

    if test "$out" != /dev/null; then
        mv "${out}" "${out}_${result}"
    fi

    mkdir -p "${cache}"
    touch "${cache}/${cache_key}_${result}"
    echo $result
}

run_tests() {
    commits=""
    iteration=0
    verification="$(echo "$verify" | git hash-object --stdin)"
    ver="$(git rev-parse --short=7 "$verification")"

    if [ -z "$GIT_QUIET" ]; then
        echo "iter | commit  | tree    | result"
        echo " ----|---------|---------|--------------"
    fi

    # Resolve all commit and tree hashes in a single git invocation;
    # spawning git per commit dominates the runtime once results are cached.
    # --abbrev=7 abbreviates exactly like `git rev-parse --short=7`, so
    # existing cache entries keep matching.
    batch="$(git show -s --abbrev=7 --format='%H %h %t' "$@")"

    while read -r commit short small; do
        cache_key="${small}_${ver}"

        redo_check "$cache_key"

        if test -n "$result"; then
            if test -z "$GIT_QUIET"; then
                progress err "cached"
                progress out "$result (cached)"
            fi
        else
            result=$(run_test)

            if test -z "$GIT_QUIET"; then
                recheck_cache "$cache_key"

                if [ "$result" != "$overall" ]; then
                    progress out "$result ($overall)"
                else
                    progress out "$result"
                fi
            fi
        fi

        if test "$result" = "fail"; then
            rc=5
        fi

        link_result

        iteration=$((iteration + 1))
    done <<EOF
$batch
EOF
}

run_staged_test() {
    iteration=0
    verification="$(echo "$verify" | git hash-object --stdin)"
    ver="$(git rev-parse --short=7 "$verification")"

    # The staged tree has a real hash, so cache lookups work as usual, but
    # there is no commit object backing it -- show a null hash in its place.
    small=$(git rev-parse --short=7 "$staged_tree")
    short=0000000
    cache_key="${small}_${ver}"

    if [ -z "$GIT_QUIET" ]; then
        echo "iter | commit  | tree    | result"
        echo " ----|---------|---------|--------------"
    fi

    redo_check "$cache_key"

    if test -n "$result"; then
        if test -z "$GIT_QUIET"; then
            progress err "cached"
            progress out "$result (cached)"
        fi
    else
        result=$(run_test staged)

        if test -z "$GIT_QUIET"; then
            recheck_cache "$cache_key"

            if [ "$result" != "$overall" ]; then
                progress out "$result ($overall)"
            else
                progress out "$result"
            fi
        fi
    fi

    if test "$result" = "fail"; then
        rc=5
    fi

    link_result
}

GIT_DIR=$(git rev-parse --git-dir 2>/dev/null || true)

# Defaults
action=test
cache=${GIT_TEST_CACHE:-"$GIT_DIR"/test-cache}
pre=${GIT_TEST_PRE:-$(git config test.pre || true)}
post=${GIT_TEST_POST:-$(git config test.post || true)}
verify=${GIT_TEST_VERIFY:-$(git config test.verify || true)}

ALL_PATTERN='^\(a\|all\|any\|always\)\?$'
FAIL_PATTERN='^\(f\|fail\|failed\|failing\)$'
PASS_PATTERN='^\(p\|pass\|passed\|passing\)$'
BOTH_PATTERN='^\(b\|both\|flap\|flappy\)$'
NONE_PATTERN='^\(n\|no\|none\|never\)$'

parse_redo() {
    if echo "$1" | grep "$ALL_PATTERN" >/dev/null; then
        redo=all
    elif echo "$1" | grep "$FAIL_PATTERN" >/dev/null; then
        redo=fail
    elif echo "$1" | grep "$PASS_PATTERN" >/dev/null; then
        redo=pass
    elif echo "$1" | grep "$NONE_PATTERN" >/dev/null; then
        redo=
    elif echo "$1" | grep "$BOTH_PATTERN" >/dev/null; then
        redo=both
    else
        printf '%s' "Unknown redo mode requested"
        rc=1
        exit $rc
    fi
}

while test $# != 0; do
    case $1 in
        -v|--verbose)
            GIT_QUIET=
            ;;
        -q|--quiet)
            verbose=
            GIT_QUIET=true
            git_am_opt="$git_am_opt -q"
            ;;
        -r|--redo)
            parse_redo "$2"
            shift
            ;;
        --redo=*)
            parse_redo "${1#--redo=}"
            ;;
        -o|--output)
            output="$2"
            shift
            ;;
        --output=*)
            output="${1#--output=}"
            ;;
        --cache)
            cache="$2"
            shift
            ;;
        --cache=*)
            cache="${1#--cache=}"
            ;;
        --pre)
            pre="$2"
            shift
            ;;
        --pre=*)
            pre="${1#--pre=}"
            ;;
        --post)
            post="$2"
            shift
            ;;
        --post=*)
            post="${1#--post=}"
            ;;
        --verify)
            verify="$2"
            shift
            ;;
        --verify=*)
            verify="${1#--verify=}"
            ;;
        --clear)
            action=clear
            ;;
        --version)
            action=version
            ;;
        --)
            shift
            break
            ;;
    esac
    shift
done

if [ "$1" = sync ]; then
    action=sync
    shift
    if test $# != 0; then
        echo "sync takes no arguments" >&2
        exit 129
    fi
fi

if [ $action = version ]; then
    echo "git-test version $VERSION"
    exit 0
elif [ -z "$GIT_DIR" ]; then
    usage
    exit 5
elif [ $action = sync ]; then
    lock
    trap 'unlock' EXIT
    sync_cache
    exit 0
else
    set_reflog_action test
    require_work_tree_exists
    cd_to_toplevel

    # Current state
    starting_point=$(git symbolic-ref --short -q HEAD || git rev-parse HEAD)
    now=$(date +%s)

    # git-test normally insists on a clean work tree.  As a convenience we
    # allow a *dirty* tree as long as every change is staged: the index is
    # written to a tree object and tested in place.  No commit object is
    # created and nothing is checked out, so the staged changes are left
    # untouched.  The motivating case is testing a merge resolution that has
    # already recorded its rerere entries but is not yet committed.  Because
    # the cache is keyed on the tree, committing that exact tree later -- the
    # merge commit -- reuses this result instead of re-running the test.
    git update-index -q --ignore-submodules --refresh
    if ! git rev-parse --verify -q HEAD >/dev/null ; then
        # No commit to diff against (unborn HEAD); defer to git's checks.
        require_clean_work_tree test
    elif ! git diff-files --quiet --ignore-submodules ; then
        # Unstaged changes would make the work tree differ from the tree we
        # record in the cache, so fall back to git's usual refusal.
        require_clean_work_tree test
    elif ! git diff-index --cached --quiet --ignore-submodules HEAD -- ; then
        staged_tree=$(git write-tree)
    fi
fi

if [ $action = clear ]; then
    if test -z "$*"; then
        rm -f "$cache"/*_fail "$cache"/*_pass
    else
        refs=( $(decide_refs "$@") )
        commits="$(git rev-list --reverse "${refs[@]}" -- | tr "$NL" " ")"
        count="$(echo "$commits" | wc -w)"

        if test 1 -gt "$count"; then
            printf '%s' "List of commits to clear is empty" 1>&2
            exit
        fi

        if test -z "$GIT_QUIET"; then
            args="$*"
            echo "$args will clear $count commits"
        fi

        for small in $(git show -s --abbrev=7 --format='%t' $commits); do
            rm -f "$cache"/"$small"_*_fail "$cache"/"$small"_*_pass
        done
    fi

    rm -Rf "$cache"/testing
    exit 0
fi

if [ -z "$verify" ]; then
    echo "A verification action is required. Specify one using
  the argument --verify=\"...\"
or
  configure it using 'git config test.verify ...'
or
  the environment variable GIT_TEST_VERIFY
"
    exit 5
fi

lock

trap "atexit_cleanup" INT TERM EXIT

if test -n "$staged_tree" ; then
    if test -z "$GIT_QUIET" ; then
        echo "Work tree is dirty; testing the staged tree in place."
    fi
    make_output_dirs
    run_staged_test
    exit $rc
fi

refs=( $(decide_refs "$@") )
commits=( $(git rev-list --reverse "${refs[@]}" -- | tr "$NL" " ") )
count="$(echo "${commits[@]}" | wc -w)"

if test 1 -gt "$count"; then
    printf '%s' 'List of commits to test is empty' 1>&2
    exit
elif test -z "$GIT_QUIET"; then
    printf '%s will test %d commits\n' "${refs[*]}" "$count"
fi

make_output_dirs

run_tests "${commits[@]}"

exit 1
